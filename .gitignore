cd /d/ShenanigansStudio

# Append missing rules to .gitignore
cat >> .gitignore << 'EOF'
__pycache__/
*.pyc
*.pyo
stems/
midi/
song-bible/
$PROFILE.txt
*.wav
*.mid
install_pages.txt
setlist-detail-page.txt
setlists-page.txt
songs-page.txt
EOF

# Untrack files that were already committed but shouldn't be
git rm --cached '$PROFILE.txt' 2>/dev/null
git rm --cached 'stems/test_wav/SS_test_wav_unknown.wav' 2>/dev/null
git rm --cached 'midi/test_wav/SS_test_wav_unknown.mid' 2>/dev/null
git rm --cached 'scripts/__pycache__/demucs_pipeline.cpython-312.pyc' 2>/dev/null
git rm --cached 'scripts/__pycache__/tempo_map.cpython-312.pyc' 2>/dev/null
git rm --cached 'song-bible/fadr_metadata.json' 2>/dev/null

git add .
git commit -m "chore: add lib helpers, fix .gitignore, untrack binary/junk files

- pwa/src/lib/fadr.js   — FADR stem job + Supabase helpers
- pwa/src/lib/reaper.js — Reaper Bridge SSE + command helpers
- pwa/src/lib/x32.js    — X32 Proxy fader/mute/SSE helpers"
__pycache__/
*.pyc
*.pyo
*.wav
*.mid
$PROFILE.txt
install_pages.txt
setlist-detail-page.txt
setlists-page.txt
songs-page.txt
song-bible/
__pycache__/
*.pyc
*.pyo
*.wav
*.mid
$PROFILE.txt
install_pages.txt
setlist-detail-page.txt
setlists-page.txt
